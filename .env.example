# Token do bot gerado pelo BotFather no Telegram
TELEGRAM_TOKEN=seu_token_aqui

# ID numérico da sua conta no Telegram (recomendado para segurança)
# Obtenha enviando uma mensagem para @userinfobot no Telegram
ALLOWED_USER_ID=seu_id_aqui

# Credenciais da conta de serviço do Google (JSON completo em uma linha)
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}

# ID da planilha do Google Sheets (está na URL da planilha)
# https://docs.google.com/spreadsheets/d/ESTE_É_O_ID/edit
SHEET_ID=id_da_planilha_aqui
